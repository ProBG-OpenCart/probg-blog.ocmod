<aside id="{{ menu_uid }}" class="card border-0 shadow-sm probg-blog-menu">
  {% if heading_title %}<div class="card-header bg-transparent border-bottom"><h3 class="h5 mb-0">{{ heading_title }}</h3></div>{% endif %}

  {% if show_blog or (show_categories and categories) %}
    <div class="list-group list-group-flush">
      {% if show_blog %}<a href="{{ blog_url }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2"><i class="fa fa-home" aria-hidden="true"></i><span>{{ text_blog_home }}</span></a>{% endif %}
      {% if show_categories and categories %}
        <div class="list-group-item text-uppercase small fw-semibold text-muted bg-light">{{ text_categories }}</div>
        {% for category in categories %}<a href="{{ category.href }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span>{{ category.title }}</span><span class="badge rounded-pill text-bg-secondary">{{ category.article_count }}</span></a>{% endfor %}
      {% endif %}
    </div>
  {% endif %}

  {% if show_articles and articles %}
    <div class="probg-blog-menu-articles p-3">
      <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <div class="text-uppercase small fw-semibold text-muted">{{ text_articles }}</div>
        {% if display == 'slider' and articles|length > 1 %}
          <div class="btn-group btn-group-sm" role="group" aria-label="{{ text_articles }}">
            <button type="button" class="btn btn-outline-secondary probg-blog-slider-prev" aria-label="{{ text_previous }}"><i class="fa fa-chevron-left" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline-secondary probg-blog-slider-next" aria-label="{{ text_next }}"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>
          </div>
        {% endif %}
      </div>

      {% if display == 'slider' %}
        <div class="probg-blog-article-slider" data-probg-blog-slider data-items-desktop="{{ items_desktop }}" data-items-tablet="{{ items_tablet }}" data-items-mobile="{{ items_mobile }}" data-autoplay="{{ slider_autoplay }}" data-interval="{{ slider_interval }}">
          <div class="probg-blog-slider-viewport">
            <div class="probg-blog-slider-track">
              {% for article in articles %}
                <article class="probg-blog-slider-slide">
                  <a href="{{ article.href }}" class="card h-100 text-decoration-none probg-blog-article-card probg-blog-slider-card">
                    {% if article.thumb %}<img src="{{ article.thumb }}" class="card-img-top img-fluid" alt="{{ article.title }}" loading="lazy">{% endif %}
                    <div class="card-body p-3">
                      {% if article.category_title %}<div class="small text-muted mb-1">{{ article.category_title }}</div>{% endif %}
                      <h4 class="h6 card-title mb-1">{{ article.title }}</h4>
                      {% if article.date_added %}<div class="small text-muted">{{ article.date_added }}</div>{% endif %}
                    </div>
                  </a>
                </article>
              {% endfor %}
            </div>
          </div>
          {% if articles|length > 1 %}<div class="probg-blog-slider-dots mt-3" aria-hidden="true"></div>{% endif %}
        </div>
      {% else %}
        <div class="probg-blog-article-list-grid" style="--probg-blog-items-desktop:{{ items_desktop }};--probg-blog-items-tablet:{{ items_tablet }};--probg-blog-items-mobile:{{ items_mobile }}">
          {% for article in articles %}
            <article class="probg-blog-list-card-item">
              <a href="{{ article.href }}" class="card h-100 text-decoration-none probg-blog-article-card probg-blog-slider-card">
                {% if article.thumb %}<img src="{{ article.thumb }}" class="card-img-top img-fluid" alt="{{ article.title }}" loading="lazy">{% endif %}
                <div class="card-body p-3">
                  {% if article.category_title %}<div class="small text-muted mb-1">{{ article.category_title }}</div>{% endif %}
                  <h4 class="h6 card-title mb-1">{{ article.title }}</h4>
                  {% if article.date_added %}<div class="small text-muted">{{ article.date_added }}</div>{% endif %}
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</aside>
