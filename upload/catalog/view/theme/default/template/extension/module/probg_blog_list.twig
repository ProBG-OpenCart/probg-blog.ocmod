{{ header }}
<div id="common-probg-blog" class="container probg-blog-page probg-blog-list-page">
  <nav aria-label="breadcrumb" class="probg-blog-breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}<li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>{% else %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endif %}
      {% endfor %}
    </ol>
  </nav>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class = 'col-sm-6 col-lg-6' %}{% elseif column_left or column_right %}{% set class = 'col-sm-9 col-lg-9' %}{% else %}{% set class = 'col-sm-12 col-lg-12' %}{% endif %}
    <main id="content" class="{{ class }}">{{ content_top }}
      <header class="probg-blog-page-header mb-5">
        <h1 class="display-5 fw-bold mb-3">{{ heading_title }}</h1>
        {% if description %}<div class="probg-blog-description lead text-muted">{{ description }}</div>{% endif %}
      </header>

      {% if categories %}
        <section class="probg-blog-categories mb-5">
          <div class="d-flex align-items-center justify-content-between mb-3"><h2 class="h3 mb-0">{{ text_categories }}</h2></div>
          <div class="row g-4 probg-blog-grid">
            {% for category in categories %}
              <div class="col-sm-6 col-lg-6">
                <div class="card h-100 border-0 shadow-sm probg-blog-category-card">
                  <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                      <h3 class="h5 card-title mb-2"><a href="{{ category.href }}" class="text-decoration-none stretched-link">{{ category.title }}</a></h3>
                      <span class="badge rounded-pill text-bg-secondary">{{ category.article_count }}</span>
                    </div>
                    {% if category.description %}<div class="card-text text-muted">{{ category.description }}</div>{% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <section class="probg-blog-articles mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3"><h2 class="h3 mb-0">{{ text_articles }}</h2></div>
        {% if articles %}
          <div class="row g-4 probg-blog-grid">
            {% for article in articles %}
              <div class="col-sm-6 col-lg-6">
                <article class="card h-100 border-0 shadow-sm probg-blog-card">
                  {% if article.image %}<a href="{{ article.href }}" class="probg-blog-card-image"><img src="{{ article.image }}" alt="{{ article.title }}" class="card-img-top img-fluid"></a>{% endif %}
                  <div class="card-body d-flex flex-column">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small">
                      <span class="text-muted">{{ article.date_added }}</span>
                      {% if article.category_title %}<a href="{{ article.category_href }}" class="badge rounded-pill text-bg-light border text-decoration-none">{{ article.category_title }}</a>{% endif %}
                    </div>
                    <h3 class="h4 card-title"><a href="{{ article.href }}" class="text-decoration-none">{{ article.title }}</a></h3>
                    {% if article.short_description %}<div class="card-text text-muted flex-grow-1 mb-3">{{ article.short_description }}</div>{% endif %}
                    <div class="mt-auto"><a href="{{ article.href }}" class="btn btn-primary">{{ text_read_more }}</a></div>
                  </div>
                </article>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="alert alert-light border" role="alert">{{ text_no_results }}</div>
        {% endif %}
      </section>

      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-4 probg-blog-pagination">
        <div>{{ pagination }}</div><div class="text-muted small">{{ results }}</div>
      </div>
      {{ content_bottom }}
    </main>{{ column_right }}
  </div>
</div>
{{ footer }}
