{{ header }}
<div id="common-probg-blog-category" class="container probg-blog-page probg-blog-category-page">
  <nav aria-label="breadcrumb" class="probg-blog-breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        {% if loop.last %}<li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.text }}</li>{% else %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}" title="{{ breadcrumb.text }}">{{ breadcrumb.text }}</a></li>{% endif %}
      {% endfor %}
    </ol>
  </nav>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class = 'col-sm-6 col-lg-6' %}{% elseif column_left or column_right %}{% set class = 'col-sm-9 col-lg-9' %}{% else %}{% set class = 'col-sm-12 col-lg-12' %}{% endif %}
    <main id="content" class="{{ class }}">{{ content_top }}
      <header class="probg-blog-page-header mb-4">
        <h1 class="display-6 fw-bold mb-3">{{ heading_title }}</h1>
        {% if description %}<div class="probg-blog-description lead text-muted">{{ description }}</div>{% endif %}
      </header>

      {% if articles %}
        {% if article_display == 'list' %}
          <div class="probg-blog-article-list probg-blog-articles-list">
            {% for article in articles %}
              <article class="card border-0 shadow-sm probg-blog-card probg-blog-card-list">
                <div class="row probg-blog-list-row">
                  {% if article.image %}
                    <div class="col-sm-4 probg-blog-list-media-column">
                      <a href="{{ article.href }}" class="probg-blog-card-image probg-blog-list-media" title="{{ article.title }}"><img src="{{ article.image }}" alt="{{ article.title }}" class="img-fluid"></a>
                    </div>
                  {% endif %}
                  <div class="{% if article.image %}col-sm-8{% else %}col-sm-12{% endif %} probg-blog-list-content-column">
                    <div class="card-body d-flex flex-column">
                      <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small">
                        <span class="text-muted">{{ article.date_added }}</span>
                        {% if article.category_title %}<a href="{{ article.category_href }}" class="badge rounded-pill text-bg-light border text-decoration-none" title="{{ article.category_title }}">{{ article.category_title }}</a>{% endif %}
                      </div>
                      <h2 class="h4 card-title"><a href="{{ article.href }}" class="text-decoration-none" title="{{ article.title }}">{{ article.title }}</a></h2>
                      {% if article.short_description %}<div class="card-text text-muted flex-grow-1 mb-3">{{ article.short_description }}</div>{% endif %}
                      <div class="mt-auto"><a class="btn btn-primary" href="{{ article.href }}" title="{{ text_read_more }}: {{ article.title }}">{{ text_read_more }}</a></div>
                    </div>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        {% else %}
          <div class="row g-4 probg-blog-grid probg-blog-articles-grid">
            {% for article in articles %}
              <div class="col-12 col-sm-6 col-md-4">
                <article class="card h-100 border-0 shadow-sm probg-blog-card">
                  {% if article.image %}<a href="{{ article.href }}" class="probg-blog-card-image" title="{{ article.title }}"><img src="{{ article.image }}" alt="{{ article.title }}" class="card-img-top img-fluid"></a>{% endif %}
                  <div class="card-body d-flex flex-column">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small">
                      <span class="text-muted">{{ article.date_added }}</span>
                      {% if article.category_title %}<a href="{{ article.category_href }}" class="badge rounded-pill text-bg-light border text-decoration-none" title="{{ article.category_title }}">{{ article.category_title }}</a>{% endif %}
                    </div>
                    <h2 class="h4 card-title"><a href="{{ article.href }}" class="text-decoration-none" title="{{ article.title }}">{{ article.title }}</a></h2>
                    {% if article.short_description %}<div class="card-text text-muted flex-grow-1 mb-3">{{ article.short_description }}</div>{% endif %}
                    <div class="mt-auto"><a class="btn btn-primary" href="{{ article.href }}" title="{{ text_read_more }}: {{ article.title }}">{{ text_read_more }}</a></div>
                  </div>
                </article>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="alert alert-light border" role="alert">{{ text_no_results }}</div>
      {% endif %}

      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-4 probg-blog-pagination">
        <div>{{ pagination }}</div><div class="text-muted small">{{ results }}</div>
      </div>
      {{ content_bottom }}
    </main>{{ column_right }}
  </div>
</div>
{{ footer }}
