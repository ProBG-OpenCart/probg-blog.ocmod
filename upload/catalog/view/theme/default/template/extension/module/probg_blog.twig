<div class="probg-blog-module"><h3>{{ heading_title }}</h3>{% if articles %}<div class="row">{% for article in articles %}<div class="col-sm-6 col-md-3">{% if article.image %}<a href="{{ article.href }}"><img src="{{ article.image }}" alt="{{ article.title }}" class="img-responsive"></a>{% endif %}<h4><a href="{{ article.href }}">{{ article.title }}</a></h4><p class="text-muted"><small>{{ article.date_added }} · <a href="{{ article.category_href }}">{{ article.category_title }}</a></small></p></div>{% endfor %}</div>{% endif %}<p><a href="{{ blog_url }}" class="btn btn-default">{{ heading_title }}</a></p></div>
