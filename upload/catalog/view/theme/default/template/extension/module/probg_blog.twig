<section class="probg-blog-module card border-0 shadow-sm">
  <div class="card-body">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h3 class="h4 mb-0">{{ heading_title }}</h3>
      <a href="{{ blog_url }}" class="btn btn-sm btn-outline-primary">{{ heading_title }}</a>
    </div>
    {% if articles %}
      <div class="row g-3 probg-blog-grid">
        {% for article in articles %}
          <div class="col-sm-6 col-lg-3">
            <article class="card h-100 border probg-blog-module-card">
              {% if article.image %}<a href="{{ article.href }}" class="probg-blog-card-image"><img src="{{ article.image }}" alt="{{ article.title }}" class="card-img-top img-fluid"></a>{% endif %}
              <div class="card-body">
                <div class="small text-muted mb-2">{{ article.date_added }}</div>
                <h4 class="h6 card-title mb-2"><a href="{{ article.href }}" class="text-decoration-none">{{ article.title }}</a></h4>
                {% if article.category_title %}<a href="{{ article.category_href }}" class="badge rounded-pill text-bg-light border text-decoration-none">{{ article.category_title }}</a>{% endif %}
              </div>
            </article>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
