<div class="probg-blog-articles-module"><h3>{{ heading_title }}</h3><div class="row">{% for article in articles %}<div class="col-sm-6 col-md-3">{% if show_image and article.image %}<a href="{{ article.href }}"><img src="{{ article.image }}" alt="{{ article.title }}" class="img-responsive"></a>{% endif %}<h4><a href="{{ article.href }}">{{ article.title }}</a></h4>{% if show_date or show_category %}<p class="text-muted"><small>{% if show_date %}{{ article.date_added }}{% endif %}{% if show_date and show_category %} · {% endif %}{% if show_category %}<a href="{{ article.category_href }}">{{ article.category_title }}</a>{% endif %}</small></p>{% endif %}<p><a href="{{ article.href }}">{{ text_read_more }}</a></p></div>{% endfor %}</div></div>
