{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-probg-blog" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button><a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    {% if success %}<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}
    <ul class="nav nav-tabs"><li class="active"><a href="{{ settings_url }}">{{ text_settings }}</a></li><li><a href="{{ categories_url }}">{{ text_categories }}</a></li><li><a href="{{ articles_url }}">{{ text_articles }}</a></li></ul>
    <div class="row"><div class="col-sm-6"><div class="tile"><div class="tile-heading">{{ text_categories }}</div><div class="tile-body"><i class="fa fa-folder-open"></i><h2 class="pull-right">{{ total_categories }}</h2></div><div class="tile-footer"><a href="{{ categories_url }}">{{ button_categories }}</a></div></div></div><div class="col-sm-6"><div class="tile"><div class="tile-heading">{{ text_articles }}</div><div class="tile-body"><i class="fa fa-file-text-o"></i><h2 class="pull-right">{{ total_articles }}</h2></div><div class="tile-footer"><a href="{{ articles_url }}">{{ button_articles }}</a></div></div></div></div>
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div><div class="panel-body">
      <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_stage_info }} &nbsp; <strong>{{ text_version }}:</strong> {{ version }} &nbsp; <strong>{{ text_stage }}:</strong> {{ stage }}</div>
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-probg-blog" class="form-horizontal">
        <ul class="nav nav-tabs"><li class="active"><a href="#tab-general" data-toggle="tab">{{ text_general }}</a></li><li><a href="#tab-content" data-toggle="tab">{{ text_content }}</a></li><li><a href="#tab-menu" data-toggle="tab">{{ text_menu }}</a></li><li><a href="#tab-images" data-toggle="tab">{{ text_images }}</a></li><li><a href="#tab-integrations" data-toggle="tab">{{ text_integrations }}</a></li></ul>
        <div class="tab-content">
          <div class="tab-pane active" id="tab-general">
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="module_probg_blog_status" class="form-control"><option value="1"{% if module_probg_blog_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_blog_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_sort }}</label><div class="col-sm-10"><select name="module_probg_blog_sort" class="form-control"><option value="date"{% if module_probg_blog_sort == 'date' %} selected{% endif %}>{{ text_date }}</option><option value="sort_order"{% if module_probg_blog_sort == 'sort_order' %} selected{% endif %}>{{ text_sort_order }}</option></select></div></div>
            <div class="form-group{% if error_limit %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_limit }}</label><div class="col-sm-10"><input type="number" min="1" max="100" name="module_probg_blog_limit" value="{{ module_probg_blog_limit }}" class="form-control">{% if error_limit %}<div class="text-danger">{{ error_limit }}</div>{% endif %}</div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_list_display }}</label><div class="col-sm-10"><select name="module_probg_blog_list_display" class="form-control"><option value="grid"{% if module_probg_blog_list_display == 'grid' %} selected{% endif %}>{{ text_grid }}</option><option value="list"{% if module_probg_blog_list_display == 'list' %} selected{% endif %}>{{ text_list }}</option></select></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_category_nav_description_status }}</label><div class="col-sm-10"><select name="module_probg_blog_category_nav_description_status" class="form-control"><option value="1"{% if module_probg_blog_category_nav_description_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_blog_category_nav_description_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
            <div class="form-group{% if error_category_nav_description_limit %} has-error{% endif %}"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_category_nav_description_limit }}">{{ entry_category_nav_description_limit }}</span></label><div class="col-sm-10"><input type="number" min="1" max="1000" name="module_probg_blog_category_nav_description_limit" value="{{ module_probg_blog_category_nav_description_limit }}" class="form-control">{% if error_category_nav_description_limit %}<div class="text-danger">{{ error_category_nav_description_limit }}</div>{% endif %}</div></div>
          </div>
          <div class="tab-pane" id="tab-content">
            <ul class="nav nav-tabs" id="language">{% for language in languages %}<li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}"> {{ language.name }}</a></li>{% endfor %}</ul>
            <div class="tab-content">{% for language in languages %}<div class="tab-pane" id="language{{ language.language_id }}">
              <div class="form-group{% if error_title[language.language_id] %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_title }}</label><div class="col-sm-10"><input type="text" name="module_probg_blog_description[{{ language.language_id }}][title]" value="{{ module_probg_blog_description[language.language_id].title|default('') }}" class="form-control">{% if error_title[language.language_id] %}<div class="text-danger">{{ error_title[language.language_id] }}</div>{% endif %}</div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_description }}</label><div class="col-sm-10"><textarea name="module_probg_blog_description[{{ language.language_id }}][description]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ module_probg_blog_description[language.language_id].description|default('') }}</textarea></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_title }}</label><div class="col-sm-10"><input type="text" name="module_probg_blog_description[{{ language.language_id }}][meta_title]" value="{{ module_probg_blog_description[language.language_id].meta_title|default('') }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_description }}</label><div class="col-sm-10"><textarea name="module_probg_blog_description[{{ language.language_id }}][meta_description]" rows="3" class="form-control">{{ module_probg_blog_description[language.language_id].meta_description|default('') }}</textarea></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_keyword }}</label><div class="col-sm-10"><textarea name="module_probg_blog_description[{{ language.language_id }}][meta_keyword]" rows="2" class="form-control">{{ module_probg_blog_description[language.language_id].meta_keyword|default('') }}</textarea></div></div>
              <div class="form-group{% if error_seo_keyword[language.language_id] %} has-error{% endif %}"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_seo_keyword }}">{{ entry_seo_keyword }}</span></label><div class="col-sm-10"><input type="text" name="module_probg_blog_description[{{ language.language_id }}][seo_keyword]" value="{{ module_probg_blog_description[language.language_id].seo_keyword|default('') }}" class="form-control">{% if error_seo_keyword[language.language_id] %}<div class="text-danger">{{ error_seo_keyword[language.language_id] }}</div>{% endif %}</div></div>
            </div>{% endfor %}</div>
          </div>
          <div class="tab-pane" id="tab-menu">
            <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ help_multiple_menus }}</div>
            <div class="clearfix" style="margin-bottom:15px"><button type="button" id="button-add-probg-menu" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> {{ button_add_menu }}</button></div>
            <div id="probg-blog-menu-editors">
              {% for menu in probg_blog_menus %}
                {% set row = loop.index0 %}
                <div class="panel panel-default probg-blog-menu-editor" data-row="{{ row }}">
                  <div class="panel-heading clearfix"><h3 class="panel-title pull-left"><i class="fa fa-bars"></i> <span class="probg-blog-menu-editor-title">{{ menu.name }}</span></h3><button type="button" class="btn btn-danger btn-xs pull-right button-remove-probg-menu"><i class="fa fa-trash"></i> {{ button_remove_menu }}</button></div>
                  <div class="panel-body">
                    <input type="hidden" name="probg_blog_menus[{{ row }}][module_id]" value="{{ menu.module_id }}">
                    <input type="hidden" name="probg_blog_menus[{{ row }}][probg_blog_type]" value="menu">
                    <div class="form-group{% if error_menu_name[row] %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_menu_name }}</label><div class="col-sm-10"><input type="text" name="probg_blog_menus[{{ row }}][name]" value="{{ menu.name }}" class="form-control probg-blog-menu-name">{% if error_menu_name[row] %}<div class="text-danger">{{ error_menu_name[row] }}</div>{% endif %}</div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_status }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][status]" class="form-control"><option value="1"{% if menu.status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not menu.status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
                    <ul class="nav nav-tabs probg-menu-language-tabs">{% for language in languages %}<li><a href="#menu-{{ row }}-language-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}"> {{ language.name }}</a></li>{% endfor %}</ul>
                    <div class="tab-content">{% for language in languages %}<div class="tab-pane" id="menu-{{ row }}-language-{{ language.language_id }}"><div class="form-group{% if error_menu_title[row][language.language_id] %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_menu_title }}</label><div class="col-sm-10"><input type="text" name="probg_blog_menus[{{ row }}][menu_description][{{ language.language_id }}][title]" value="{{ menu.menu_description[language.language_id].title|default('') }}" class="form-control">{% if error_menu_title[row][language.language_id] %}<div class="text-danger">{{ error_menu_title[row][language.language_id] }}</div>{% endif %}</div></div></div>{% endfor %}</div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_blog }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][show_blog]" class="form-control"><option value="1"{% if menu.show_blog %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not menu.show_blog %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_categories }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][show_categories]" class="form-control"><option value="1"{% if menu.show_categories %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not menu.show_categories %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_articles }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][show_articles]" class="form-control"><option value="1"{% if menu.show_articles %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not menu.show_articles %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_menu_category }}">{{ entry_menu_category }}</span></label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][category_id]" class="form-control"><option value="0">{{ text_all_categories }}</option>{% for category in menu_categories %}<option value="{{ category.category_id }}"{% if category.category_id == menu.category_id %} selected{% endif %}>{{ category.title }}</option>{% endfor %}</select></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_sort }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][sort]" class="form-control"><option value="date"{% if menu.sort == 'date' %} selected{% endif %}>{{ text_date }}</option><option value="sort_order"{% if menu.sort == 'sort_order' %} selected{% endif %}>{{ text_sort_order }}</option></select></div></div>
                    <div class="form-group{% if error_menu_limit[row] %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_menu_limit }}</label><div class="col-sm-10"><input type="number" min="1" max="100" name="probg_blog_menus[{{ row }}][limit]" value="{{ menu.limit }}" class="form-control">{% if error_menu_limit[row] %}<div class="text-danger">{{ error_menu_limit[row] }}</div>{% endif %}</div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_display }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][display]" class="form-control probg-menu-display"><option value="list"{% if menu.display == 'list' %} selected{% endif %}>{{ text_menu_list }}</option><option value="slider"{% if menu.display == 'slider' %} selected{% endif %}>{{ text_menu_slider }}</option></select></div></div>
                    <div class="form-group{% if error_items[row].desktop %} has-error{% endif %}"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_desktop }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[{{ row }}][items_desktop]" value="{{ menu.items_desktop }}" class="form-control">{% if error_items[row].desktop %}<div class="text-danger">{{ error_items[row].desktop }}</div>{% endif %}</div></div>
                    <div class="form-group{% if error_items[row].tablet %} has-error{% endif %}"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_tablet }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[{{ row }}][items_tablet]" value="{{ menu.items_tablet }}" class="form-control">{% if error_items[row].tablet %}<div class="text-danger">{{ error_items[row].tablet }}</div>{% endif %}</div></div>
                    <div class="form-group{% if error_items[row].mobile %} has-error{% endif %}"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_mobile }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[{{ row }}][items_mobile]" value="{{ menu.items_mobile }}" class="form-control">{% if error_items[row].mobile %}<div class="text-danger">{{ error_items[row].mobile }}</div>{% endif %}</div></div>
                    <div class="probg-menu-slider-options"{% if menu.display != 'slider' %} style="display:none"{% endif %}>
                      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_slider_autoplay }}</label><div class="col-sm-10"><select name="probg_blog_menus[{{ row }}][slider_autoplay]" class="form-control"><option value="1"{% if menu.slider_autoplay %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not menu.slider_autoplay %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
                      <div class="form-group{% if error_slider_interval[row] %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ entry_slider_interval }}</label><div class="col-sm-10"><input type="number" min="1000" max="30000" step="500" name="probg_blog_menus[{{ row }}][slider_interval]" value="{{ menu.slider_interval }}" class="form-control">{% if error_slider_interval[row] %}<div class="text-danger">{{ error_slider_interval[row] }}</div>{% endif %}</div></div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="tab-pane" id="tab-images">
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_default_image }}</label><div class="col-sm-10"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="module_probg_blog_default_image" value="{{ module_probg_blog_default_image }}" id="input-image"></div></div>
            {% set sizes = {'list': [module_probg_blog_image_list_width,module_probg_blog_image_list_height,entry_image_list], 'article': [module_probg_blog_image_article_width,module_probg_blog_image_article_height,entry_image_article], 'gallery': [module_probg_blog_image_gallery_width,module_probg_blog_image_gallery_height,entry_image_gallery]} %}
            {% for key, size in sizes %}<div class="form-group{% if error_image %} has-error{% endif %}"><label class="col-sm-2 control-label">{{ size[2] }}</label><div class="col-sm-5"><input type="number" min="1" name="module_probg_blog_image_{{ key }}_width" value="{{ size[0] }}" class="form-control" placeholder="Width"></div><div class="col-sm-5"><input type="number" min="1" name="module_probg_blog_image_{{ key }}_height" value="{{ size[1] }}" class="form-control" placeholder="Height"></div></div>{% endfor %}
            {% if error_image %}<div class="text-danger col-sm-offset-2">{{ error_image }}</div>{% endif %}
          </div>
          <div class="tab-pane" id="tab-integrations">
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_sitemap }}</label><div class="col-sm-10"><select name="module_probg_blog_sitemap" class="form-control"><option value="1"{% if module_probg_blog_sitemap %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_blog_sitemap %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cache }}</label><div class="col-sm-10"><select name="module_probg_blog_cache" class="form-control"><option value="1"{% if module_probg_blog_cache %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_probg_blog_cache %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          </div>
        </div>
      </form>
    </div></div>
  </div>
</div>
<script type="text/template" id="probg-blog-menu-template">
  <div class="panel panel-default probg-blog-menu-editor" data-row="__ROW__">
    <div class="panel-heading clearfix"><h3 class="panel-title pull-left"><i class="fa fa-bars"></i> <span class="probg-blog-menu-editor-title">ProBG Blog Menu</span></h3><button type="button" class="btn btn-danger btn-xs pull-right button-remove-probg-menu"><i class="fa fa-trash"></i> {{ button_remove_menu }}</button></div>
    <div class="panel-body">
      <input type="hidden" name="probg_blog_menus[__ROW__][module_id]" value="0"><input type="hidden" name="probg_blog_menus[__ROW__][probg_blog_type]" value="menu">
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_name }}</label><div class="col-sm-10"><input type="text" name="probg_blog_menus[__ROW__][name]" value="ProBG Blog Menu" class="form-control probg-blog-menu-name"></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_status }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][status]" class="form-control"><option value="1" selected>{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div></div>
      <ul class="nav nav-tabs probg-menu-language-tabs">{% for language in languages %}<li><a href="#menu-__ROW__-language-{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}"> {{ language.name }}</a></li>{% endfor %}</ul>
      <div class="tab-content">{% for language in languages %}<div class="tab-pane" id="menu-__ROW__-language-{{ language.language_id }}"><div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_title }}</label><div class="col-sm-10"><input type="text" name="probg_blog_menus[__ROW__][menu_description][{{ language.language_id }}][title]" value="" class="form-control"></div></div></div>{% endfor %}</div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_blog }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][show_blog]" class="form-control"><option value="1" selected>{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_categories }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][show_categories]" class="form-control"><option value="1" selected>{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_show_articles }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][show_articles]" class="form-control"><option value="1" selected>{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_category }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][category_id]" class="form-control"><option value="0">{{ text_all_categories }}</option>{% for category in menu_categories %}<option value="{{ category.category_id }}">{{ category.title }}</option>{% endfor %}</select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_sort }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][sort]" class="form-control"><option value="date" selected>{{ text_date }}</option><option value="sort_order">{{ text_sort_order }}</option></select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_limit }}</label><div class="col-sm-10"><input type="number" min="1" max="100" name="probg_blog_menus[__ROW__][limit]" value="10" class="form-control"></div></div>
      <div class="form-group"><label class="col-sm-2 control-label">{{ entry_menu_display }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][display]" class="form-control probg-menu-display"><option value="list" selected>{{ text_menu_list }}</option><option value="slider">{{ text_menu_slider }}</option></select></div></div>
      <div class="form-group"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_desktop }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[__ROW__][items_desktop]" value="3" class="form-control"></div></div>
      <div class="form-group"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_tablet }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[__ROW__][items_tablet]" value="2" class="form-control"></div></div>
      <div class="form-group"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_items_per_view }}">{{ entry_items_mobile }}</span></label><div class="col-sm-10"><input type="number" min="1" max="6" name="probg_blog_menus[__ROW__][items_mobile]" value="1" class="form-control"></div></div>
      <div class="probg-menu-slider-options" style="display:none">
        <div class="form-group"><label class="col-sm-2 control-label">{{ entry_slider_autoplay }}</label><div class="col-sm-10"><select name="probg_blog_menus[__ROW__][slider_autoplay]" class="form-control"><option value="1" selected>{{ text_enabled }}</option><option value="0">{{ text_disabled }}</option></select></div></div>
        <div class="form-group"><label class="col-sm-2 control-label">{{ entry_slider_interval }}</label><div class="col-sm-10"><input type="number" min="1000" max="30000" step="500" name="probg_blog_menus[__ROW__][slider_interval]" value="5000" class="form-control"></div></div>
      </div>
    </div>
  </div>
</script>
<script>
$('#language a:first').tab('show');
$('.probg-menu-language-tabs').each(function(){ $(this).find('a:first').tab('show'); });
var probgMenuRow = {{ probg_blog_menus|length }};
$('#button-add-probg-menu').on('click', function(){
  var html = $('#probg-blog-menu-template').html().replace(/__ROW__/g, probgMenuRow++);
  var $menu = $(html).appendTo('#probg-blog-menu-editors');
  $menu.find('.probg-menu-language-tabs a:first').tab('show');
});
$(document).on('click', '.button-remove-probg-menu', function(){ $(this).closest('.probg-blog-menu-editor').remove(); });
$(document).on('input', '.probg-blog-menu-name', function(){ $(this).closest('.probg-blog-menu-editor').find('.probg-blog-menu-editor-title').text($(this).val() || 'ProBG Blog Menu'); });
$(document).on('change', '.probg-menu-display', function(){ $(this).closest('.probg-blog-menu-editor').find('.probg-menu-slider-options').toggle($(this).val() === 'slider'); });
</script>
{{ footer }}
