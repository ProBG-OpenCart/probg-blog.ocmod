{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-article" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>{% endif %}

    <ul class="nav nav-tabs">
      <li><a href="{{ settings_url }}">{{ tab_settings }}</a></li>
      <li><a href="{{ categories_url }}">{{ tab_categories }}</a></li>
      <li class="active"><a href="{{ articles_url }}">{{ tab_articles }}</a></li>
    </ul>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-article" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-content" data-toggle="tab">{{ text_content }}</a></li>
            <li><a href="#tab-data" data-toggle="tab">{{ text_data }}</a></li>
            <li><a href="#tab-images" data-toggle="tab">{{ text_images }}</a></li>
            <li><a href="#tab-related" data-toggle="tab">{{ text_related }}</a></li>
          </ul>

          <div class="tab-content">
            <div id="tab-content" class="tab-pane active">
              <ul class="nav nav-tabs" id="language">{% for language in languages %}<li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}"> {{ language.name }}</a></li>{% endfor %}</ul>
              <div class="tab-content">
                {% for language in languages %}
                  <div id="language{{ language.language_id }}" class="tab-pane">
                    <div class="form-group required"><label class="col-sm-2 control-label">{{ entry_title }}</label><div class="col-sm-10"><input type="text" name="article_description[{{ language.language_id }}][title]" value="{{ article_description[language.language_id].title|default('') }}" class="form-control">{% if error_title[language.language_id] %}<div class="text-danger">{{ error_title[language.language_id] }}</div>{% endif %}</div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_short_description }}</label><div class="col-sm-10"><textarea name="article_description[{{ language.language_id }}][short_description]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ article_description[language.language_id].short_description|default('') }}</textarea></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_description }}</label><div class="col-sm-10"><textarea name="article_description[{{ language.language_id }}][description]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ article_description[language.language_id].description|default('') }}</textarea></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_title }}</label><div class="col-sm-10"><input type="text" name="article_description[{{ language.language_id }}][meta_title]" value="{{ article_description[language.language_id].meta_title|default('') }}" placeholder="{{ text_automatic }}" class="form-control"></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_description }}</label><div class="col-sm-10"><textarea name="article_description[{{ language.language_id }}][meta_description]" rows="3" class="form-control">{{ article_description[language.language_id].meta_description|default('') }}</textarea></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label">{{ entry_meta_keyword }}</label><div class="col-sm-10"><textarea name="article_description[{{ language.language_id }}][meta_keyword]" rows="2" class="form-control">{{ article_description[language.language_id].meta_keyword|default('') }}</textarea></div></div>
                    <div class="form-group"><label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_seo_keyword }}">{{ entry_seo_keyword }}</span></label><div class="col-sm-10"><input type="text" name="article_description[{{ language.language_id }}][seo_keyword]" value="{{ article_description[language.language_id].seo_keyword|default('') }}" placeholder="{{ text_automatic }}" class="form-control">{% if error_seo_keyword[language.language_id] %}<div class="text-danger">{{ error_seo_keyword[language.language_id] }}</div>{% endif %}</div></div>
                  </div>
                {% endfor %}
              </div>
            </div>

            <div id="tab-data" class="tab-pane">
              <div class="form-group required"><label class="col-sm-2 control-label">{{ entry_category }}</label><div class="col-sm-10"><select name="category_id" class="form-control"><option value="0">---</option>{% for category in categories %}<option value="{{ category.category_id }}"{% if category.category_id == category_id %} selected{% endif %}>{{ category.title }}</option>{% endfor %}</select>{% if error_category %}<div class="text-danger">{{ error_category }}</div>{% endif %}</div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_sort_order }}</label><div class="col-sm-10"><input type="number" name="sort_order" value="{{ sort_order }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="status" class="form-control"><option value="1"{% if status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_date_added }}</label><div class="col-sm-10"><p class="form-control-static">{{ date_added }}</p></div></div>
              <div class="form-group"><label class="col-sm-2 control-label">{{ entry_date_modified }}</label><div class="col-sm-10"><p class="form-control-static">{{ date_modified }}</p></div></div>
            </div>

            <div id="tab-images" class="tab-pane">
              <div class="form-group"><label class="col-sm-2 control-label">{{ text_main_image }}</label><div class="col-sm-10"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="image" value="{{ image }}" id="input-image"></div></div>
              <div class="table-responsive">
                <table class="table table-bordered" id="images">
                  <thead><tr><td>{{ entry_image }}</td><td>{{ entry_sort_order }}</td><td></td></tr></thead>
                  <tbody>
                    {% set image_row = 0 %}
                    {% for article_image in article_images %}
                      <tr id="image-row{{ image_row }}"><td><a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="img-thumbnail"><img src="{{ article_image.thumb }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="article_image[{{ image_row }}][image]" value="{{ article_image.image }}" id="input-image{{ image_row }}"></td><td><input type="number" name="article_image[{{ image_row }}][sort_order]" value="{{ article_image.sort_order }}" class="form-control"></td><td><button type="button" onclick="$('#image-row{{ image_row }}').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td></tr>
                      {% set image_row = image_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot><tr><td colspan="2"></td><td><button type="button" onclick="addImage();" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td></tr></tfoot>
                </table>
              </div>
            </div>

            <div id="tab-related" class="tab-pane">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-related"><span data-toggle="tooltip" title="{{ help_related }}">{{ entry_related }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="related" value="" placeholder="{{ entry_related }}" id="input-related" class="form-control">
                  <div id="article-related" class="well well-sm" style="height: 150px; overflow: auto;">
                    {% for product_related in product_relateds %}
                      <div id="article-related{{ product_related.product_id }}"><i class="fa fa-minus-circle"></i> {{ product_related.name }}<input type="hidden" name="article_related[]" value="{{ product_related.product_id }}"></div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#language a:first').tab('show');
var image_row = {{ image_row|default(0) }};
function addImage() {
    var html = '<tr id="image-row' + image_row + '"><td><a href="" id="thumb-image' + image_row + '" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" data-placeholder="{{ placeholder }}"></a><input type="hidden" name="article_image[' + image_row + '][image]" value="" id="input-image' + image_row + '"></td><td><input type="number" name="article_image[' + image_row + '][sort_order]" value="0" class="form-control"></td><td><button type="button" onclick="$(\'#image-row' + image_row + '\').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td></tr>';
    $('#images tbody').append(html);
    image_row++;
}

$('input[name=\'related\']').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=catalog/product/autocomplete&user_token={{ user_token }}&filter_name=' + encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                response($.map(json, function(item) {
                    return { label: item['name'], value: item['product_id'] };
                }));
            }
        });
    },
    'select': function(item) {
        $('input[name=\'related\']').val('');
        $('#article-related' + item['value']).remove();
        $('#article-related').append('<div id="article-related' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="article_related[]" value="' + item['value'] + '"></div>');
    }
});

$('#article-related').delegate('.fa-minus-circle', 'click', function() {
    $(this).parent().remove();
});
//--></script>
{{ footer }}
